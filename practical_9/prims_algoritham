import time

# Prim's Algorithm
def prim(graph):
    n = len(graph)

    # Keep track of vertices included in MST
    selected = [False] * n

    # Start from vertex 0
    selected[0] = True

    total_cost = 0

    print("Edges in Minimum Spanning Tree:")
    
    for _ in range(n - 1):

        minimum = float('inf')
        x = -1
        y = -1

        # Find minimum weight edge
        for i in range(n):
            if selected[i]:
                for j in range(n):
                    if not selected[j] and graph[i][j] != 0:
                        if graph[i][j] < minimum:
                            minimum = graph[i][j]
                            x = i
                            y = j

        # Add edge to MST
        print(x, "--", y, "=", minimum)

        total_cost += minimum
        selected[y] = True

    print("Total MST Cost:", total_cost)


# Graph represented using adjacency matrix
graph = [
    [0, 2, 0, 6, 0],
    [2, 0, 3, 8, 5],
    [0, 3, 0, 0, 7],
    [6, 8, 0, 0, 9],
    [0, 5, 7, 9, 0]
]



start_time = time.perf_counter()

prim(graph)

# End execution time
end_time = time.perf_counter()

# Execution time
execution_time = end_time - start_time

print("\nExecution Time:", execution_time, "seconds")
print("Time Complexity: O(V²)")
print("Space Complexity: O(V²)")